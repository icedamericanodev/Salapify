  "annotations": [
    { "id": "papel-note", "x": 0, "y": -240, "w": 520, "text": "Papel: your utang notebook, typeset. Chosen 2026-09-12 by a five-reviewer panel (Flutter UX, user panel, product, brand, competitor benchmark) as the mix of Kwaderno and Barako Editorial.\nLight is the primary look; Tinta (dark) is an option derived from the same tokens. One accent, terracotta. Fraunces only for the hero number and the cycle title; Plus Jakarta Sans for everything else. Three signature devices: the ledger row, the serif hero, the BAYAD NA stamp. No cards, no ruled lines, no mascot, no ring.\nAll figures are sample values.", "page": "page-1" },
    { "id": "read-me", "x": 0, "y": -200, "w": 480, "text": "The three directions the theme was chosen from. A and C were mixed; B was dropped except for the days-to-payday line in the header.", "page": "page-2" },
    { "id": "generic-note", "x": 0, "y": -160, "w": 420, "text": "Kept for comparison only. The generic dark fintech template (near-black, cards, one orange accent) the founder rejected as a Tarsi copy.", "page": "page-3" }
