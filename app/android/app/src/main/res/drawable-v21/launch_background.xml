<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen, shown by the OS before Flutter draws its first frame.
     It is Salapify's own background colour plus the mark, so the app does not
     open on a white flash that belongs to no theme. The colour resolves
     per-theme through values/ and values-night/. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/salapify_launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
