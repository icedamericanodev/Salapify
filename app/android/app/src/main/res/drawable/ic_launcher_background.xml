<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon's background layer: Salapify's hero ramp.

  A VECTOR gradient rather than a bitmap, deliberately. The launcher scales and
  parallax-shifts this layer independently of the foreground, so a bitmap would
  be resampled at sizes it was never exported for. A gradient the system draws
  is sharp at every density and weighs nothing.

  The three stops are the heroGradient in app/lib/design/tokens.dart, byte for
  byte, so the icon and the app's own hero panel can never drift apart.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#FFFFD9B0" android:offset="0.0" />
                <item android:color="#FFFEC078" android:offset="0.5" />
                <item android:color="#FFFB9C52" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
