<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon. Three layers, and the third is not optional any more:
  Android 16 QPR2 forces themed icons and apps cannot opt out, so an app that
  ships no monochrome layer gets one generated from its artwork, unpredictably.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
