<?xml version="1.0" encoding="utf-8"?>
<!-- The whole tile. RemoteViews only: LinearLayout and TextView, nothing else.
     ConstraintLayout is allowed in RemoteViews from API 31 only, which would
     split behaviour across Android versions for no gain here.

     The android:text values below are NOT placeholders. They are what a tile
     dragged out before the app has ever run actually shows, and they are also
     what the widget picker previews. So a tile placed on a fresh install looks
     intentional and says exactly what to do next. Kotlin's per-key fallbacks
     match these strings, so a half written preferences file renders the same
     way rather than blank. That sentence was FALSE for one round, in a comment
     asserting it: the XML said "Salapify" and Kotlin said "Start here".

     yn_sub takes maxLines="2" while every other row takes 1. Not symmetry, a
     decision. It is the only row carrying a sentence, this row is frozen in
     the APK, and shortening a sentence ships over the air while raising
     maxLines costs another manual install. So the copy is capped at 36
     characters in Dart (money/widget_tile.dart, subLineCap, with a test) to
     fit one line, and the second line is the free insurance for a resized
     tile, where wrapping beats a sentence cut mid-word. -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/yn_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <TextView
        android:id="@+id/yn_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOUR NUMBER"
        android:textColor="#FFA99182"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.18"
        android:maxLines="1" />

    <TextView
        android:id="@+id/yn_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Start here"
        android:textColor="#FFFBF3E9"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/yn_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add your cash to get started."
        android:textColor="#FFA99182"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/yn_asof"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text=""
        android:textColor="#FFA99182"
        android:textSize="10sp"
        android:maxLines="1"
        android:visibility="gone" />

    <!-- Pushes the bar to the bottom whatever the headline size does.
         An empty TextView, NOT a Space. RemoteViews inflates through a filter
         that only admits classes annotated @RemoteView, and android.widget
         .Space carries no such annotation, so a Space here throws
         InflateException and the launcher draws "Problem loading widget"
         instead of the tile. On every Android version, in the picker preview
         too. TextView is annotated, and an empty one is a valid spacer. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="" />

    <LinearLayout
        android:id="@+id/yn_bar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/widget_bar_bg">

        <TextView
            android:id="@+id/yn_bar_plus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textColor="#FFFF8A3D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/yn_bar_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log an expense"
            android:textColor="#FFFF8A3D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
