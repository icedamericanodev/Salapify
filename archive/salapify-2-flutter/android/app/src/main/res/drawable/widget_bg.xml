<?xml version="1.0" encoding="utf-8"?>
<!-- The tile background. Fixed Barako dark on every phone and every theme,
     deliberately. A rounded background colour cannot be set from RemoteViews
     before API 31, so theming it would mean the same theme looks different on
     Android 11 and Android 12, which reads as a bug. The launch audience is
     the Philippines, where plenty of phones are still on 11. Themed TEXT, one
     fixed card. A dark tile on a light phone is normal for widgets. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF251A13" />
    <corners android:radius="@dimen/widget_corner" />
</shape>
