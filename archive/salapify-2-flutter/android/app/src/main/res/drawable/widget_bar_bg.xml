<?xml version="1.0" encoding="utf-8"?>
<!-- The Log bar: an outline, not a fill. The bar is the ACTION, and an
     outlined control on a dark card reads as tappable without competing with
     the number, which is the thing the tile exists to show. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke android:width="1dp" android:color="#40FF8A3D" />
    <corners android:radius="12dp" />
</shape>
