{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive-edits.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for a destructive edit pattern"
          }
        ]
      }
    ]
  }
}